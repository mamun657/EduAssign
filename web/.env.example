# Frontend environment template — copy to `web/.env.local` for local dev
# or set the same keys in your Render service dashboard for production.
#
# NOTE: Any variable prefixed with `NEXT_PUBLIC_` is inlined into the
# browser bundle at build time, so changing it requires a rebuild.

# Local dev (default if unset in the API client):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:5220

# Production (Render):
NEXT_PUBLIC_API_BASE_URL=https://eduassign-api.onrender.com
