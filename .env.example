# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored. NEVER commit real credentials.

# --- MongoDB ---
# Local dev (Docker):                          mongodb://localhost:27017
# MongoDB Atlas (DO NOT commit the credential): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=<app>
MONGO__CONNECTIONSTRING=
MONGO__DATABASENAME=EduAssignPro

# --- JWT (HS256, secret MUST be >= 32 chars) ---
# Generate one with: openssl rand -base64 48
JWT__SECRET=
JWT__ISSUER=EduAssignPro
JWT__AUDIENCE=EduAssignPro.Client
JWT__EXPIRATIONMINUTES=720

# --- Optional: bootstrap admin user on first run (idempotent) ---
# Leave blank to skip. After the first run, the user lives in MongoDB and
# these values are ignored.
SEED__ADMINEMAIL=admin@eduassign.local
SEED__ADMINPASSWORD=
SEED__ADMINFIRSTNAME=System
SEED__ADMINLASTNAME=Administrator